SUPABASE_ANON_KEY=

# ---- Razorpay (required for checkout) ----
# Use the same mode for both keys. The checkout widget key lives in index.html.
RAZORPAY_KEY_ID=rzp_live_TafLQCc6Jt5AsG
RAZORPAY_KEY_SECRET=uxmTppBkWhaeSCw2rPV8ID1z
